{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "README.md", "firestore.rules"],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{"key": "Cache-Control", "value": "public,max-age=3600"}]
      }
    ],
    "rewrites": [{"source": "**", "destination": "/index.html"}]
  },
  "firestore": {"rules": "firestore.rules"}
}
